# This repository is the plugin, not the surrounding production workspace.
# New top-level content is private until deliberately allowlisted here.
/*
!/.gitignore
!/.gitattributes
!/package.json
!/package-lock.json
!/cordis.patch.yml
!/README.md
!/LICENSE
!/NOTICE
!/THIRD_PARTY_NOTICES.md
!/SECURITY.md
!/src/
!/skills/
!/scripts/
!/test/
!/docs/

# Generated artifacts / dependencies. Build locally; never commit them.
node_modules/
lib/
coverage/
dist/
*.tgz
*.zip
*.tar
*.gz

# Credentials, machine configuration, session state and tool caches.
.env
.env.*
!.env.example
*.local.*
*.pem
*.key
*.p12
*.pfx
*.keystore
*.log
*.sqlite*
*.db
*.jsonl
.dsh/
.codex/
.agents/
.cache/
__pycache__/
private/
sessions/
uploads/
attachments/
director-media/
director-skills/
staged-images/
outputs/
recordings/
models/

# Workflows are discovered in the user's environment, not shipped by this plugin.
workflows/
src/templates/
# Optional official guides belong only in the user's external download cache.
/skills/h3-prompt-writing/references/ref-en.txt
/skills/h3-prompt-writing/references/base-en.txt
/skills/h3-prompt-writing/references/upstream-SKILL.md

# No production assets, voices, recordings or model weights belong in Git.
*.png
*.jpg
*.jpeg
*.webp
*.gif
*.mp4
*.mkv
*.mov
*.webm
*.wav
*.mp3
*.flac
*.safetensors
*.gguf
*.ckpt
*.pt
*.pth
.DS_Store
Thumbs.db
