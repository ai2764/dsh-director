{
  "name": "dsh-director",
  "version": "0.1.28",
  "description": "Director and H3 skills, managed ComfyUI submission, and conversation media previews for DeepSeek Harness Web",
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "main": "lib/index.mjs",
  "exports": {".": "./lib/index.mjs", "./client": "./lib/client.js", "./package.json": "./package.json"},
  "files": ["lib/*.mjs", "lib/client.js", "skills", "cordis.patch.yml", "README.md", "LICENSE", "LICENSE.minimax-h3", "NOTICE", "THIRD_PARTY_NOTICES.md", "SECURITY.md"],
  "engines": {"node": ">=22"},
  "scripts": {"test": "node --test src/*.test.mjs test/*.test.mjs", "build": "node scripts/build.mjs", "prepack": "npm run build"},
  "dsh": {
    "bundle": {"patch": "./cordis.patch.yml"},
    "client": {"platform": "web", "inject": ["@deepseek-ai/dsh-client-ui-tool", "@deepseek-ai/dsh-client-ui-renderer", "@deepseek-ai/dsh-client-ui-conversation"]}
  },
  "peerDependencies": {"@deepseek-ai/cordis": "^4.0.2"},
  "dependencies": {"@deepseek-ai/schemastery": "^3.18.2"},
  "devDependencies": {"esbuild": "^0.25.0", "react": "^18.2.0", "react-dom": "^18.2.0", "jsdom": "^26.0.0", "yaml": "^2.8.0"}
}
