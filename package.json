{
  "name": "dsh-director",
  "version": "0.1.76",
  "description": "Director tools and skills, optional official H3 guide downloads, and conversation media previews for DeepSeek Harness Web",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ai2764/dsh-director.git"
  },
  "homepage": "https://github.com/ai2764/dsh-director#readme",
  "bugs": {
    "url": "https://github.com/ai2764/dsh-director/issues"
  },
  "type": "module",
  "main": "lib/index.mjs",
  "exports": {
    ".": "./lib/index.mjs",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/*.mjs",
    "lib/client.js",
    "skills/director",
    "skills/h3-prompt-writing/SKILL.md",
    "skills/h3-prompt-writing/references/UPSTREAM.md",
    "cordis.patch.yml",
    "README.md",
    "docs/CONFIGURATION.md",
    "docs/RELEASE_REVIEW.md",
    "LICENSE",
    "NOTICE",
    "THIRD_PARTY_NOTICES.md",
    "SECURITY.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test src/*.test.mjs test/*.test.mjs",
    "build": "node scripts/build.mjs",
    "prepack": "npm run build"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-tool",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.2"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "jsdom": "^26.0.0",
    "yaml": "^2.8.0"
  }
}
